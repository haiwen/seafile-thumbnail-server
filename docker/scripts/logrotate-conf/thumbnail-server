/opt/seafile/logs/seafile.log
/opt/seafile/logs/thumbnail-server.log
{
        daily
        missingok
        rotate 7
        # compress
        # delaycompress
        dateext
        dateformat .%Y-%m-%d
        notifempty
        create 644 root root
        sharedscripts
        postrotate
                if [ -f /opt/seafile/pids/seafile.pid ]; then
                        kill -USR1 `cat /opt/seafile/pids/seafile.pid`
                fi

                /scripts/thumbnail-server.sh restart-thumbnail
        endscript
}
